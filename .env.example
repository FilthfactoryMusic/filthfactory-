# Booth transport: livekit | mesh
# Preview/staging defaults to livekit when this is unset.
# www/production (filthfactory.co.uk) stays on mesh unless you set livekit here.
LIVE_TRANSPORT=

# LiveKit Cloud — server only. Never put these in VITE_* or client code.
# Project URL looks like wss://<project>.livekit.cloud
# Leave empty until the host env has real values. The booth fails closed if they are missing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
