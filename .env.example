# Booth transport: livekit | mesh
# Names only — never put real values in git.
# Preview/staging defaults to livekit when this is unset.
# Production (including filthfactory.co.uk) stays mesh until you set livekit here AFTER soak PASS.
# Do not set LIVE_TRANSPORT=livekit on Production until Preview soak has passed.
LIVE_TRANSPORT=

# LiveKit Cloud — server only. Never put these in VITE_* or client code.
# Set on Vercel Preview (and later Production only after soak PASS):
#   LIVEKIT_URL
#   LIVEKIT_API_KEY
#   LIVEKIT_API_SECRET
# Project URL looks like wss://<project>.livekit.cloud
# Leave empty until the host env has real values. Missing keys fail closed — no mesh fallback.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
